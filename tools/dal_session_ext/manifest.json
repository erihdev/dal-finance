{
  "manifest_version": 3,
  "name": "دال — نقل الجلسات للمتصفح السحابي",
  "version": "1.5",
  "description": "ينقل جلسات الدخول (بدون كلمات مرور) لفودكس ورتم وبونات وعلو إلى متصفح دال السحابي بضغطة زر.",
  "permissions": [
    "cookies",
    "scripting",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "https://*.foodics.com/*",
    "https://retm.sa/*",
    "https://*.retm.sa/*",
    "https://*.bonat.io/*",
    "https://*.olu.sa/*",
    "https://browser-production-10fb.up.railway.app/*",
    "https://*.salla.sa/*",
    "https://s.salla.sa/*",
    "https://api.salla.dev/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "نقل الجلسات إلى دال"
  }
}