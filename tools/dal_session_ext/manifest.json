{
  "manifest_version": 3,
  "name": "دال — نقل الجلسات للمتصفح السحابي",
  "version": "2.1",
  "description": "ينقل جلسات الدخول (بدون كلمات مرور) إلى متصفح دال السحابي: يدوياً بضغطة، وتلقائياً كل 30 دقيقة.",
  "permissions": [
    "alarms",
    "cookies",
    "scripting",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "https://*.foodics.com/*",
    "https://retm.sa/*",
    "https://*.retm.sa/*",
    "https://*.bonat.io/*",
    "https://*.olu.sa/*",
    "https://browser-production-10fb.up.railway.app/*",
    "https://*.salla.sa/*",
    "https://s.salla.sa/*",
    "https://*.tamara.co/*",
    "https://api.salla.dev/*",
    "https://pullupme.io/*",
    "https://*.pullupme.io/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "نقل الجلسات إلى دال"
  },
  "background": {
    "service_worker": "background.js"
  }
}